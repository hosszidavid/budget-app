generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryKind {
  EXPENSE
  INCOME
}

enum ExpenseSource {
  MANUAL
  RECEIPT
}

enum CategoryAmountBehavior {
  NORMAL
  NEGATIVE
  POSITIVE
}

enum ReceiptStatus {
  DRAFT
  READY
  SAVED
}

enum ReceiptLineSource {
  MANUAL
  AI
  MAPPING
}

enum ReceiptStructureAction {
  MERGE
  SPLIT
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  baseCurrency String   @default("CHF")
  geminiModel String    @default("gemini-3.5-flash")
  dataSpaceId String    @default(uuid()) @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions          Session[]
  people            Person[]
  merchants         Merchant[]
  categories        CategoryNode[]
  reusableItems     ReusableItem[]
  expensePurchases  ExpensePurchase[]
  incomeEntries     IncomeEntry[]
  receipts          Receipt[]
  receiptMappings   ReceiptMapping[]
  receiptStructureRules ReceiptStructureRule[]
  balanceLocations  BalanceLocation[]
  monthSnapshots    MonthSnapshot[]
  receiptImages     ReceiptImage[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}


model ReceiptImage {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  receiptId    String?  @unique @db.Uuid
  data         Bytes?
  blobUrl      String?
  blobPathname String?
  sizeBytes    Int?
  mimeType     String
  originalName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model AuthRateLimit {
  key          String   @id
  attempts     Int      @default(0)
  windowStart  DateTime @default(now())
  blockedUntil DateTime?
  updatedAt    DateTime @updatedAt
}

model Person {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  name       String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  expensePurchases ExpensePurchase[]
  incomeEntries    IncomeEntry[]
  balanceEntries   BalanceEntry[]
  receipts         Receipt[]
  @@unique([userId, name])
  @@index([userId, archivedAt])
}

model Merchant {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  name       String
  normalized String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchases ExpensePurchase[]
  receipts  Receipt[]
  @@unique([userId, normalized])
  @@index([userId, archivedAt])
}

model BalanceLocation {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  name       String
  normalized String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries    BalanceEntry[]
  @@unique([userId, normalized])
  @@index([userId, archivedAt])
}

model CategoryNode {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  kind       CategoryKind
  name       String
  normalized String
  depth      Int
  color      String?
  amountBehavior CategoryAmountBehavior @default(NORMAL)
  parentId   String?      @db.Uuid
  archivedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    CategoryNode?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  CategoryNode[] @relation("CategoryTree")
  reusableItems ReusableItem[]
  expenseItems  ExpenseItem[]
  receiptLines  ReceiptLine[]
  receiptMappings ReceiptMapping[]
  receiptStructureRules ReceiptStructureRule[]
  incomeEntries IncomeEntry[]
  @@unique([userId, kind, parentId, normalized])
  @@index([userId, kind, archivedAt])
  @@index([parentId])
}

model ReusableItem {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  kind       CategoryKind
  name       String
  normalized String
  categoryId String?      @db.Uuid
  usageCount Int          @default(0)
  lastUsedAt DateTime?
  archivedAt DateTime?
  isDairy        Boolean @default(false)
  containsEgg    Boolean @default(false)
  containsAnimal Boolean @default(false)
  isAlcohol      Boolean @default(false)
  isFrozen       Boolean @default(false)
  isCanned       Boolean @default(false)
  isPackaged     Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category CategoryNode? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  expenseItems ExpenseItem[]
  receiptLines  ReceiptLine[]
  receiptMappings ReceiptMapping[]
  receiptStructureRules ReceiptStructureRule[]
  @@unique([userId, kind, normalized])
  @@index([userId, kind, archivedAt, usageCount])
}

model Receipt {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  merchantId    String?       @db.Uuid
  personId      String?       @db.Uuid
  purchaseDate  DateTime?
  currency      String?
  declaredTotal Decimal?      @db.Decimal(18, 4)
  note          String?
  status        ReceiptStatus @default(DRAFT)
  imageStorageKey String?
  imageMimeType   String?
  imageOriginalName String?
  aiModel       String?
  aiProcessedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant  Merchant?     @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  person    Person?       @relation(fields: [personId], references: [id], onDelete: SetNull)
  purchase  ExpensePurchase?
  lines     ReceiptLine[]
  @@index([userId, createdAt])
  @@index([personId])
}

model ReceiptLine {
  id             String   @id @default(uuid()) @db.Uuid
  receiptId      String   @db.Uuid
  rawLabel       String?
  label          String
  amount         Decimal  @db.Decimal(18, 4)
  reusableItemId String?  @db.Uuid
  categoryId     String?  @db.Uuid
  note           String?
  source         ReceiptLineSource @default(MANUAL)
  aiConfidence   Decimal? @db.Decimal(5, 4)
  isDairy        Boolean @default(false)
  containsEgg    Boolean @default(false)
  containsAnimal Boolean @default(false)
  isAlcohol      Boolean @default(false)
  isFrozen       Boolean @default(false)
  isCanned       Boolean @default(false)
  isPackaged     Boolean @default(false)
  components     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  receipt      Receipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  reusableItem ReusableItem? @relation(fields: [reusableItemId], references: [id], onDelete: SetNull)
  category     CategoryNode?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  @@index([receiptId])
  @@index([categoryId])
}


model ReceiptMapping {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  merchantNormalized String
  rawNormalized      String
  reusableItemId     String?  @db.Uuid
  categoryId         String?  @db.Uuid
  label              String
  isDairy            Boolean  @default(false)
  containsEgg        Boolean  @default(false)
  containsAnimal     Boolean  @default(false)
  isAlcohol          Boolean  @default(false)
  isFrozen           Boolean  @default(false)
  isCanned           Boolean  @default(false)
  isPackaged         Boolean  @default(false)
  usageCount         Int      @default(1)
  lastUsedAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reusableItem ReusableItem? @relation(fields: [reusableItemId], references: [id], onDelete: SetNull)
  category     CategoryNode?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  @@unique([userId, merchantNormalized, rawNormalized])
  @@index([userId, merchantNormalized])
}


model ReceiptStructureRule {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @db.Uuid
  merchantNormalized   String
  signature            String
  action               ReceiptStructureAction
  components           Json
  targetLabel          String?
  targetReusableItemId String?  @db.Uuid
  targetCategoryId     String?  @db.Uuid
  usageCount           Int      @default(1)
  lastUsedAt           DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reusableItem ReusableItem? @relation(fields: [targetReusableItemId], references: [id], onDelete: SetNull)
  category     CategoryNode?  @relation(fields: [targetCategoryId], references: [id], onDelete: SetNull)
  @@unique([userId, merchantNormalized, signature])
  @@index([userId, merchantNormalized, updatedAt])
}

model ExpensePurchase {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  date       DateTime
  currency   String
  note       String?
  source     ExpenseSource @default(MANUAL)
  personId   String?       @db.Uuid
  merchantId String?       @db.Uuid
  receiptId  String?       @unique @db.Uuid
  fxRate     Decimal? @db.Decimal(20, 10)
  fxDate     DateTime?
  fxSource   String?
  baseAmount Decimal? @db.Decimal(18, 4)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  person   Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  receipt  Receipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  items    ExpenseItem[]
  @@index([userId, date, deletedAt])
  @@index([personId])
  @@index([merchantId])
}

model ExpenseItem {
  id             String   @id @default(uuid()) @db.Uuid
  purchaseId     String   @db.Uuid
  reusableItemId String?  @db.Uuid
  categoryId     String?  @db.Uuid
  label          String
  amount         Decimal  @db.Decimal(18, 4)
  note           String?
  isDairy        Boolean @default(false)
  containsEgg    Boolean @default(false)
  containsAnimal Boolean @default(false)
  isAlcohol      Boolean @default(false)
  isFrozen       Boolean @default(false)
  isCanned       Boolean @default(false)
  isPackaged     Boolean @default(false)
  fuelLiters Decimal? @db.Decimal(12, 4)
  odometerKm Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchase     ExpensePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  reusableItem ReusableItem?   @relation(fields: [reusableItemId], references: [id], onDelete: SetNull)
  category     CategoryNode?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  @@index([purchaseId])
  @@index([categoryId])
}

model IncomeEntry {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  personId   String   @db.Uuid
  categoryId String?  @db.Uuid
  date       DateTime
  label      String
  amount     Decimal  @db.Decimal(18, 4)
  currency   String
  note       String?
  fxRate     Decimal? @db.Decimal(20, 10)
  fxDate     DateTime?
  fxSource   String?
  baseAmount Decimal? @db.Decimal(18, 4)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  person   Person        @relation(fields: [personId], references: [id], onDelete: Restrict)
  category CategoryNode? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  @@index([userId, date, deletedAt])
  @@index([personId])
}

model MonthSnapshot {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @db.Uuid
  year                 Int
  month                Int
  manualOpeningBase    Decimal?  @db.Decimal(18, 4)
  expectedAtClose      Decimal?  @db.Decimal(18, 4)
  closedAt             DateTime?
  note                 String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries               BalanceEntry[]
  @@unique([userId, year, month])
  @@index([userId, year, month])
}

model BalanceEntry {
  id          String   @id @default(uuid()) @db.Uuid
  snapshotId  String   @db.Uuid
  personId    String?  @db.Uuid
  locationId  String?  @db.Uuid
  label       String
  amount      Decimal  @db.Decimal(18, 4)
  currency    String
  fxRate      Decimal? @db.Decimal(20, 10)
  fxDate      DateTime?
  fxSource    String?
  baseAmount  Decimal? @db.Decimal(18, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  snapshot MonthSnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  person   Person?        @relation(fields: [personId], references: [id], onDelete: SetNull)
  location BalanceLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  @@index([snapshotId])
  @@index([personId])
  @@index([locationId])
}
