# Local development uses Docker PostgreSQL.
DATABASE_URL="postgresql://budget:budget@localhost:5432/budget?schema=public"
# On Neon/Vercel use the pooled Neon URL above and the direct URL below.
# DIRECT_URL="postgresql://...direct-neon-connection...?sslmode=require"
SESSION_DAYS="30"
FX_API_BASE="https://api.frankfurter.dev/v1"

# Server-side only. Never expose this key in client code.
GOOGLE_AI_STUDIO_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# Receipt AI request timeout (milliseconds). Vercel Hobby supports up to 300s.
RECEIPT_AI_TIMEOUT_MS="240000"

# Local default: receipt images stay in PostgreSQL.
# Production on Vercel: create a PRIVATE Vercel Blob store and set this to vercel-blob.
RECEIPT_IMAGE_STORAGE="database"
# BLOB_READ_WRITE_TOKEN is injected automatically when the Blob store is connected.

# Production account safety. Registration is closed by default.
# ALLOW_REGISTRATION="false"
# REGISTRATION_TOKEN="use-a-long-random-private-invite-code-if-you-need-signup"
